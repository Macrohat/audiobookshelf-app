default_platform(:ios)

# Macrohat TestFlight pipeline for the audiobookshelf-app fork.
# Mac-free CI: every Apple-side action authenticates via App Store Connect API key.
#
# Required env (provided by .github/workflows/ios-testflight.yml from GitHub Secrets):
#   APP_STORE_CONNECT_KEY_ID
#   APP_STORE_CONNECT_ISSUER_ID
#   APP_STORE_CONNECT_KEY_CONTENT_B64   (base64 of the .p8 file)
#   APPLE_TEAM_ID                       (Apple Developer team id, 10 chars)
#   MATCH_PASSWORD                      (encryption passphrase for the signing repo)
#   MATCH_GIT_BASIC_AUTHORIZATION       (base64 of "user:pat" for Macrohat/ios-signing)
#   IOS_APP_BUNDLE_ID                   (defaults to co.macrohat.audiobookshelf)

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT_B64"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  end

  desc "Resolve signing assets via match (idempotent; creates on first run)"
  lane :signing do
    match(
      type: "appstore",
      app_identifier: [ENV.fetch("IOS_APP_BUNDLE_ID", "co.macrohat.audiobookshelf")],
      readonly: false,
      force_for_new_devices: false
    )
  end

  desc "Build a release ipa and upload to TestFlight"
  lane :beta do
    # 1. Ensure cert + profile exist (and are checked into Macrohat/ios-signing)
    signing

    # 2. Scope signing settings to the App target ONLY (target name is
    # "Audiobookshelf" — scheme name "App" != target name).
    # Without target-scoping, PROVISIONING_PROFILE_SPECIFIER in xcargs
    # leaks to every target in the workspace including Pods (Realm,
    # Capacitor, Alamofire, etc.) which can't accept provisioning
    # profiles since they build as static libs. This rewrites the App
    # target's Release config in-place before archive.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      targets: ["Audiobookshelf"],
      build_configurations: ["Release"],
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: ENV.fetch("IOS_APP_BUNDLE_ID", "co.macrohat.audiobookshelf"),
      profile_name: "match AppStore #{ENV.fetch('IOS_APP_BUNDLE_ID', 'co.macrohat.audiobookshelf')}",
      code_sign_identity: "Apple Distribution"
    )

    # 3. Compute next build number from App Store Connect so we never collide
    next_build = latest_testflight_build_number(
      app_identifier: ENV.fetch("IOS_APP_BUNDLE_ID", "co.macrohat.audiobookshelf"),
      initial_build_number: 100
    ) + 1
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: next_build.to_s
    )

    # 4. Build. xcargs is minimal — signing settings live on the App
    # target itself (step 2) so xcodebuild doesn't try to apply them to
    # Pods. -allowProvisioningUpdates lets Xcode talk to ASC if anything
    # is missing.
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "Audiobookshelf-Macrohat.ipa",
      xcargs: "-allowProvisioningUpdates"
    )

    # 4. Push to TestFlight; do not wait for processing to keep CI minutes low
    upload_to_testflight(
      app_identifier: ENV.fetch("IOS_APP_BUNDLE_ID", "co.macrohat.audiobookshelf"),
      skip_waiting_for_build_processing: true,
      changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Macrohat build #{next_build} from commit #{ENV['GITHUB_SHA'] ? ENV['GITHUB_SHA'][0,8] : 'local'}"
    )
  end
end
